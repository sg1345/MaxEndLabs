@model NewsArticleDetailsViewModel

@{
    ViewData["Title"] = Model.ContentTitle;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">News</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Article Details</li>
                </ol>
            </nav>

            <header class="py-3">
                <h1 class="display-4 fw-bold text-dark">@Model.ContentTitle</h1>
            </header>

            @if (!string.IsNullOrEmpty(Model.ArticleImageUrl))
            {
                <div class="mb-4">
                    <img src="@Model.ArticleImageUrl"
                         class="img-fluid rounded shadow w-100"
                         alt="Featured image for @Model.ContentTitle"
                         style="max-height: 500px; object-fit: cover;">
                </div>
            }
            <section class="fs-5 text-secondary lh-base mb-5" style="white-space: pre-line;">
	            @Model.Content
            </section>

            <footer class="border-top pt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-primary px-4">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <span class="text-muted small">Article ID: @Model.Id</span>
                </div>
            </footer>
        </div>
    </div>
</div>